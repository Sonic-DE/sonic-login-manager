# The cursor must be applied after compositor readiness and before either UI.
cmake_minimum_required(VERSION 3.16)

function(require_entry path entry)
    file(STRINGS "${SOURCE_DIR}/${path}" lines)
    if(NOT "${entry}" IN_LIST lines)
        message(FATAL_ERROR "${path} is missing: ${entry}")
    endif()
endfunction()

function(require_dependency path key dependency)
    file(STRINGS "${SOURCE_DIR}/${path}" entries REGEX "^${key}=")
    set(dependencies)
    foreach(entry IN LISTS entries)
        string(REGEX REPLACE "^[^=]*=" "" value "${entry}")
        separate_arguments(words UNIX_COMMAND "${value}")
        list(APPEND dependencies ${words})
    endforeach()
    if(NOT "${dependency}" IN_LIST dependencies)
        message(FATAL_ERROR "${path} is missing ${key} dependency: ${dependency}")
    endif()
endfunction()

set(compositor_unit "src/frontend/startkde/soniclogin-sonic-win.service.in")
# sonic-win.service already watches org.kde.KWin in the same user manager.
# Even inactive units cannot declare a second watcher for that bus name.
file(STRINGS "${SOURCE_DIR}/${compositor_unit}" bus_names REGEX "^[ \t]*BusName=")
if(bus_names)
    message(FATAL_ERROR "${compositor_unit} must not duplicate the desktop compositor's BusName")
endif()
require_entry("${compositor_unit}" "ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/sonic-win --replace")
require_entry("src/frontend/startkde/soniclogin-apply-kscreen.service.in" "Type=oneshot")
require_entry("src/frontend/startkde/soniclogin-apply-kscreen.service.in" "TimeoutStartSec=40s")
require_dependency("src/frontend/startkde/soniclogin-apply-kscreen.service.in" After soniclogin-sonic-win.service)
require_dependency("src/frontend/startkde/soniclogin-apply-kscreen.service.in" Requires soniclogin-sonic-win.service)
require_dependency("src/frontend/startkde/soniclogin-apply-kscreen.service.in" Before soniclogin.service)
require_dependency("src/frontend/startkde/soniclogin-apply-kscreen.service.in" Before soniclogin-wallpaper.service)
require_entry("src/frontend/startkde/soniclogin-apply-kscreen.service.in" "ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/start-soniclogin-x11 --apply-kscreen")
require_dependency("src/frontend/greeter/soniclogin.service.in" Requires soniclogin-apply-kscreen.service)
require_dependency("src/frontend/greeter/soniclogin.service.in" After soniclogin-sonic-win.service)
require_dependency("src/frontend/greeter/soniclogin.service.in" After soniclogin-apply-kscreen.service)
