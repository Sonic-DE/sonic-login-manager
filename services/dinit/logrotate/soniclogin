# /etc/logrotate.d/soniclogin

# dinit opened logfile as the daemon's output, so it is copied and truncated:
# a renamed file would keep receiving the daemon's output.
/var/log/sonic/soniclogin.log /var/log/sonic-login-manager.err {
    daily
    rotate 7
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
}

# The helper isn't service-managed; it rotates to .last on every run.
/var/log/sonic/soniclogin-helper.log.last {
    rotate 1
    compress
    missingok
}
