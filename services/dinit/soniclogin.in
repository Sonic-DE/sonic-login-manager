# dinit service file for Sonic Login Manager
# Install as /etc/dinit.d/soniclogin

type = process
command = @CMAKE_INSTALL_FULL_BINDIR@/soniclogin
smooth-recovery = true
# The daemon recognises dinit's capture and writes its log lines to stdout.
logfile         = /var/log/sonic/soniclogin.log
depends-on      = soniclogin-logdir
depends-on      = logind
depends-on      = login.target
