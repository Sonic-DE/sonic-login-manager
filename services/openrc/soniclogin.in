#!/sbin/openrc-run
# Copyright 2024 SonicDE Community
# Distributed under the terms of the BSD0 License

description="Sonic Login Manager"
supervisor=supervise-daemon

command="@CMAKE_INSTALL_FULL_BINDIR@/soniclogin"
command_args="--foreground"
pidfile="/run/soniclogin.pid"

# The daemon recognises supervise-daemon's capture and writes its log lines to stdout.
output_log="/var/log/sonic/soniclogin.log"
error_log="/var/log/sonic-login-manager.err"

depend() {
    need localmount

    after bootmisc consolefont modules netmount
    after ypbind autofs openvpn gpm lircmd
    after quota keymaps acpid
    before alsasound
    want logind
    use xfs
    provide xdm display-manager
}

start_pre() {
    # Create or repair /var/log/sonic with the daemon's own trust rules before
    # supervise-daemon opens output_log inside it; an insecure old directory is
    # moved aside, never taken over.
    "${command}" --prepare-log-directory || return 1
    checkpath -f -m 0644 -o root:root "${output_log}" "${error_log}"
}
