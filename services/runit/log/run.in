#!/bin/sh
exec 2>&1; set -e

# Create or repair /var/log/sonic with the daemon's own trust rules first; the
# subdirectory is then safe to create inside the trusted, root-only parent.
@CMAKE_INSTALL_FULL_BINDIR@/soniclogin --prepare-log-directory
[ -d /var/log/sonic/soniclogin ] || mkdir -m 0755 /var/log/sonic/soniclogin

# The old svlogd directory isn't written any more; rm doesn't follow a symlink.
rm -rf /var/log/sonic-login-manager

# No -tt: every line the daemon writes already carries its timestamp.
exec svlogd /var/log/sonic/soniclogin
